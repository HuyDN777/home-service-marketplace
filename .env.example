# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=houseservicedb
DB_CONNECTION_LIMIT=10

# Application
PORT=3000
NODE_ENV=development

# Authentication
ACCESS_SECRET_KEY=
REFRESH_SECRET_KEY=
SESSION_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Email
EMAIL_USER=
EMAIL_PASS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# VNPay sandbox
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/api/vnpay/vnpay-return
VNP_IPN_URL=http://localhost:3000/api/vnpay/vnpay-ipn

# Cancellation policy: 20% late fee, 80% of that fee paid to the assigned partner
CANCELLATION_FEE_RATE=0.20
PARTNER_CANCELLATION_SHARE_RATE=0.80
PARTNER_JOB_SHARE_RATE=0.80
PARTNER_MIN_BALANCE=-200000
CUSTOMER_CONFIRMATION_HOURS=24

# Development/demo only. Never enable this in production.
VNP_REFUND_MOCK_COMPLETED=false

<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dịch vụ - Dọn Nhà Vui</title><link rel="stylesheet" href="/css/admin/app.css"></head><body><%- include('../layouts/admin_sidebar') %><main class="admin-main" data-page="services"><div class="page-head"><div><span class="eyebrow">NỘI DUNG / DỊCH VỤ</span><h1>Dịch vụ</h1><p>Giá và đơn vị tính hiển thị cho khách khi đặt lịch.</p></div><button class="button" type="button" data-open-dialog="serviceDialog" id="newService"><i data-lucide="plus"></i>Thêm dịch vụ</button></div><div id="pageNotice" hidden></div><div class="table-toolbar"><h2>Danh sách dịch vụ</h2><form method="get"><label for="pageSize">Số dòng</label><select id="pageSize" name="pageSize" onchange="this.form.submit()"><% [10,20,50].forEach(size => { %><option value="<%= size %>" <%= pageSize === size ? 'selected' : '' %>><%= size %></option><% }) %></select></form></div><div class="table-scroll"><table><thead><tr><th>Dịch vụ</th><th>Danh mục</th><th>Giá</th><th>Đơn vị</th><th>Mô tả</th><th>Thao tác</th></tr></thead><tbody><% if (!services.length) { %><tr><td colspan="6" class="empty-row">Chưa có dịch vụ</td></tr><% } %><% services.forEach(s => { %><tr><td><div style="display:flex;align-items:center;gap:10px"><img class="thumb" src="<%= s.image_url || '/images/user/don_nha.jpg' %>" alt=""><span><strong><%= s.name %></strong><small>#<%= s.id %></small></span></div></td><td><%= s.category || '-' %></td><td><strong><%= Number(s.price).toLocaleString('vi-VN') %>đ</strong></td><td><%= s.unit || 'lần' %></td><td><%= s.description || '-' %></td><td><button class="button secondary" type="button" data-edit-service data-id="<%= s.id %>" data-name="<%= s.name %>" data-price="<%= s.price %>" data-unit="<%= s.unit || '' %>" data-description="<%= s.description || '' %>" data-category="<%= s.Categoryid || '' %>" data-image="<%= s.image_url || '' %>">Sửa</button></td></tr><% }) %></tbody></table></div><%- include('../layouts/admin_pagination') %></main><dialog class="dialog" id="serviceDialog"><div class="dialog-header"><h2 id="serviceDialogTitle">Thêm dịch vụ</h2><button class="icon-button" type="button" data-close-dialog aria-label="Đóng">×</button></div><form id="serviceForm"><input name="id" type="hidden"><input name="existingImage" type="hidden"><div class="form-grid"><label class="form-field wide">Tên dịch vụ<input name="name" required></label><label class="form-field">Giá (VNĐ)<input name="price" type="number" min="0" step="1000" required></label><label class="form-field">Đơn vị tính<input name="unit" placeholder="giờ, lần, m²..." required></label><label class="form-field wide">Danh mục<select name="Categoryid" required><option value="">Chọn danh mục</option><% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label class="form-field wide">Mô tả<textarea name="description"></textarea></label><label class="form-field wide">Ảnh dịch vụ<input name="image" type="file" accept="image/*"></label></div><div class="dialog-actions"><button class="button secondary" type="button" data-close-dialog>Hủy</button><button class="button" type="submit">Lưu dịch vụ</button></div></form></dialog><script src="/js/admin/pages.js" defer></script></body></html>

<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cộng tác viên - Dọn Nhà Vui</title><link rel="stylesheet" href="/css/admin/app.css"></head><body><%- include('../layouts/admin_sidebar') %><main class="admin-main" data-page="employees"><div class="page-head"><div><span class="eyebrow">ĐỐI TÁC / CỘNG TÁC VIÊN</span><h1>Cộng tác viên</h1><p>Duyệt tài khoản và quản lý người nhận việc.</p></div><button class="button" type="button" data-open-dialog="employeeDialog"><i data-lucide="user-plus"></i>Thêm CTV</button></div><div id="pageNotice" hidden></div><div class="metrics"><div class="metric alert"><span>Chờ duyệt / Tạm khóa · trang này</span><strong><%= employees.filter(e => !e.active).length %></strong></div><div class="metric"><span>Đang hoạt động · trang này</span><strong><%= employees.filter(e => e.active).length %></strong></div></div><div class="table-toolbar"><h2>Danh sách CTV</h2><form method="get"><label for="pageSize">Số dòng</label><select id="pageSize" name="pageSize" onchange="this.form.submit()"><% [10,20,50].forEach(size => { %><option value="<%= size %>" <%= pageSize === size ? 'selected' : '' %>><%= size %></option><% }) %></select></form></div><div class="table-scroll"><table><thead><tr><th>CTV</th><th>Dịch vụ</th><th>Liên hệ</th><th>Kinh nghiệm</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% if (!employees.length) { %><tr><td colspan="6" class="empty-row">Chưa có cộng tác viên</td></tr><% } %><% employees.forEach(emp => { %><tr><td><strong><%= emp.name %></strong><small>#<%= emp.id %> · <%= emp.username %></small></td><td><%= emp.service_name || 'Chưa chọn' %></td><td><strong><%= emp.phone || '-' %></strong><small><%= emp.email || '-' %></small></td><td><%= emp.experience || 0 %> năm</td><td><span class="status <%= emp.active ? 'good' : 'pending' %>"><%= emp.active ? 'Đang hoạt động' : 'Chờ duyệt / Tạm khóa' %></span></td><td><button class="button <%= emp.active ? 'secondary' : '' %>" type="button" data-partner-id="<%= emp.id %>" data-partner-action="<%= emp.active ? 'suspend' : 'approve' %>"><%= emp.active ? 'Tạm khóa' : 'Duyệt' %></button></td></tr><% }) %></tbody></table></div><%- include('../layouts/admin_pagination') %></main><dialog class="dialog" id="employeeDialog"><div class="dialog-header"><h2>Thêm CTV</h2><button class="icon-button" type="button" data-close-dialog aria-label="Đóng">×</button></div><form id="employeeForm"><div class="form-grid"><label class="form-field">Họ tên<input name="name" required></label><label class="form-field">Tên đăng nhập<input name="username" required></label><label class="form-field">Mật khẩu<input name="password" type="password" minlength="8" required></label><label class="form-field">Kinh nghiệm (năm)<input name="experience" type="number" min="0" value="0" required></label><label class="form-field">Dịch vụ<select name="Serviceid" required><option value="">Chọn dịch vụ</option><% services.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></label><label class="form-field">Số điện thoại<input name="phone" type="tel"></label><label class="form-field">Email<input name="email" type="email"></label><label class="form-field">Địa chỉ<input name="address"></label><label class="form-field wide">Ảnh đại diện<input name="image" type="file" accept="image/*"></label></div><div class="dialog-actions"><button class="button secondary" type="button" data-close-dialog>Hủy</button><button class="button" type="submit">Thêm CTV</button></div></form></dialog><script src="/js/admin/pages.js" defer></script></body></html>

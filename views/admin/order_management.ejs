<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đơn hàng - Dọn Nhà Vui</title><link rel="stylesheet" href="/css/admin/app.css"></head><body><%- include('../layouts/admin_sidebar') %><main class="admin-main"><div class="page-head"><div><span class="eyebrow">VẬN HÀNH / ĐƠN HÀNG</span><h1>Đơn hàng</h1><p>Theo dõi ca đang mở và tiến độ thực hiện.</p></div><a class="button secondary" href="/admin/orders?page=<%= page %>&pageSize=<%= pageSize %>"><i data-lucide="refresh-cw"></i>Làm mới</a></div><div class="metrics"><div class="metric alert"><span>Chờ CTV nhận · trang này</span><strong><%= orders.filter(o => o.status === 'PENDING').length %></strong></div><div class="metric"><span>Đã nhận · trang này</span><strong><%= orders.filter(o => o.status === 'ASSIGNED').length %></strong></div><div class="metric"><span>Đang làm · trang này</span><strong><%= orders.filter(o => o.status === 'IN_PROGRESS').length %></strong></div><div class="metric"><span>Tổng đơn · trang này</span><strong><%= orders.length %></strong></div></div><div class="table-toolbar"><h2>Danh sách đơn</h2><form method="get"><label for="pageSize">Số dòng</label><select id="pageSize" name="pageSize" onchange="this.form.submit()"><% [10,20,50].forEach(size => { %><option value="<%= size %>" <%= pageSize === size ? 'selected' : '' %>><%= size %></option><% }) %></select></form></div><div class="table-scroll"><table><thead><tr><th>Đơn</th><th>Khách / dịch vụ</th><th>Thời gian ca</th><th>CTV</th><th>Trạng thái việc</th><th>Thanh toán</th></tr></thead><tbody><% if (!orders.length) { %><tr><td colspan="6" class="empty-row">Chưa có đơn hàng</td></tr><% } %><% orders.forEach(o => { %><tr><td><strong>#<%= o.id %></strong><small><%= o.booking_date ? new Date(o.booking_date).toLocaleDateString('vi-VN') : '' %></small></td><td><strong><%= o.customer_name || 'Khách hàng' %></strong><small><%= o.service_name || '-' %></small></td><td><strong><%= o.start_datetime ? new Date(o.start_datetime).toLocaleString('vi-VN', { dateStyle: 'short', timeStyle: 'short' }) : '-' %></strong><small><%= o.end_datetime ? 'Đến ' + new Date(o.end_datetime).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) : '' %></small></td><td><%= o.employee_name || 'Chưa có CTV' %></td><td><span class="status <%= o.status === 'PENDING' ? 'pending' : ['ASSIGNED','COMPLETED'].includes(o.status) ? 'good' : o.status === 'IN_PROGRESS' ? 'progress' : 'warn' %>"><%= ({PENDING:'Chờ CTV nhận',ASSIGNED:'Đã nhận',IN_PROGRESS:'Đang làm',WORK_DONE:'Chờ khách xác nhận',COMPLETED:'Hoàn thành',CANCELLED:'Đã hủy'})[o.status] || o.status %></span></td><td><span class="status <%= o.payment_status === 'PAID' ? 'good' : o.payment_status === 'FAILED' ? 'bad' : 'pending' %>"><%= ({UNPAID:'Chưa trả',PENDING:'Đang xử lý',PAID:'Đã trả',FAILED:'Thất bại',REFUNDED:'Hoàn tiền'})[o.payment_status] || o.payment_status || '-' %></span></td></tr><% }) %></tbody></table></div><%- include('../layouts/admin_pagination') %></main></body></html>

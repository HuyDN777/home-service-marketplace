<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Yêu cầu hỗ trợ - Dọn Nhà Vui</title><link rel="stylesheet" href="/css/admin/app.css"></head><body><%- include('../layouts/admin_sidebar') %><main class="admin-main" data-page="disputes"><div class="page-head"><div><span class="eyebrow">VẬN HÀNH / HỖ TRỢ</span><h1>Yêu cầu hỗ trợ</h1><p>Xử lý các đơn khách chưa đồng ý xác nhận hoàn thành.</p></div><a class="button secondary" href="/admin/orders">Đơn hàng</a></div><div id="pageNotice" hidden></div><div class="table-scroll"><table><thead><tr><th>Đơn</th><th>Khách / CTV</th><th>Nội dung</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% if (!disputes.length) { %><tr><td colspan="5" class="empty-row">Chưa có yêu cầu hỗ trợ</td></tr><% } %><% disputes.forEach(d => { %><tr><td><strong>#<%= d.Orderid %></strong><small><%= d.service_name || '-' %></small></td><td><strong><%= d.customer_name || '-' %></strong><small>CTV: <%= d.employee_name || '-' %></small></td><td><%= d.reason %><% if (d.admin_note) { %><small><%= d.admin_note %></small><% } %></td><td><span class="status <%= d.status === 'OPEN' ? 'pending' : 'good' %>"><%= d.status === 'OPEN' ? 'Đang xử lý' : 'Đã xử lý' %></span></td><td><% if (d.status === 'OPEN') { %><div class="cell-actions" data-dispute-order="<%= d.Orderid %>"><button class="button" type="button" data-dispute-decision="COMPLETE">Chốt hoàn thành</button><button class="button secondary" type="button" data-dispute-decision="REWORK">Yêu cầu làm lại</button></div><% } else { %>-<% } %></td></tr><% }) %></tbody></table></div></main><script src="/js/admin/pages.js" defer></script></body></html>

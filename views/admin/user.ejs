<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Khách hàng - Dọn Nhà Vui</title><link rel="stylesheet" href="/css/admin/app.css"></head><body><%- include('../layouts/admin_sidebar') %><main class="admin-main"><div class="page-head"><div><span class="eyebrow">TÀI KHOẢN / KHÁCH HÀNG</span><h1>Khách hàng</h1><p>Thông tin liên hệ của tài khoản đã đăng ký.</p></div></div><div class="table-toolbar"><h2>Danh sách khách hàng</h2><form method="get"><label for="pageSize">Số dòng</label><select id="pageSize" name="pageSize" onchange="this.form.submit()"><% [10,20,50].forEach(size => { %><option value="<%= size %>" <%= pageSize === size ? 'selected' : '' %>><%= size %></option><% }) %></select></form></div><div class="table-scroll"><table><thead><tr><th>Khách hàng</th><th>Tên đăng nhập</th><th>Email</th><th>Số điện thoại</th><th>Địa chỉ</th></tr></thead><tbody><% if (!users.length) { %><tr><td colspan="5" class="empty-row">Chưa có khách hàng</td></tr><% } %><% users.forEach(u => { %><tr><td><strong><%= u.name || '-' %></strong><small>#<%= u.id %></small></td><td><%= u.username || '-' %></td><td><%= u.email || '-' %></td><td><%= u.phone || '-' %></td><td><%= u.address || '-' %></td></tr><% }) %></tbody></table></div><%- include('../layouts/admin_pagination') %></main></body></html>

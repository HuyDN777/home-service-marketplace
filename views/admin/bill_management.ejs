<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hóa đơn - Dọn Nhà Vui</title><link rel="stylesheet" href="/css/admin/app.css"></head><body><%- include('../layouts/admin_sidebar') %><main class="admin-main"><div class="page-head"><div><span class="eyebrow">TÀI CHÍNH / HÓA ĐƠN</span><h1>Hóa đơn</h1><p>Danh sách khoản tiền theo đơn; trạng thái thanh toán thực tế nằm ở đơn hàng.</p></div><a class="button secondary" href="/admin/orders"><i data-lucide="clipboard-list"></i>Xem đơn</a></div><div class="table-toolbar"><h2>Danh sách hóa đơn</h2><form method="get"><label for="pageSize">Số dòng</label><select id="pageSize" name="pageSize" onchange="this.form.submit()"><% [10,20,50].forEach(size => { %><option value="<%= size %>" <%= pageSize === size ? 'selected' : '' %>><%= size %></option><% }) %></select></form></div><div class="table-scroll"><table><thead><tr><th>Hóa đơn</th><th>Đơn hàng</th><th>Số tiền</th><th>Trạng thái hóa đơn</th><th>Ngày ghi nhận</th></tr></thead><tbody><% if (!bills.length) { %><tr><td colspan="5" class="empty-row">Chưa có hóa đơn</td></tr><% } %><% bills.forEach(b => { %><tr><td><strong>#<%= b.id %></strong></td><td>#<%= b.Orderid || b.order_id || '-' %></td><td><strong><%= Number(b.amount || 0).toLocaleString('vi-VN') %>đ</strong></td><td><span class="status <%= /da thanh toan/i.test(b.status || '') ? 'good' : 'pending' %>"><%= b.status || '-' %></span></td><td><%= b.date ? new Date(b.date).toLocaleString('vi-VN') : '-' %></td></tr><% }) %></tbody></table></div><%- include('../layouts/admin_pagination') %></main></body></html>

<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Khuyến mãi - Dọn Nhà Vui</title><link rel="stylesheet" href="/css/admin/app.css"></head><body><%- include('../layouts/admin_sidebar') %><main class="admin-main" data-page="coupons"><div class="page-head"><div><span class="eyebrow">NỘI DUNG / KHUYẾN MÃI</span><h1>Khuyến mãi</h1><p>Tạo mã giảm giá theo khoảng thời gian áp dụng.</p></div><button class="button" type="button" data-open-dialog="couponDialog"><i data-lucide="plus"></i>Thêm mã</button></div><div id="pageNotice" hidden></div><div class="table-toolbar"><h2>Danh sách mã</h2><form method="get"><label for="pageSize">Số dòng</label><select id="pageSize" name="pageSize" onchange="this.form.submit()"><% [10,20,50].forEach(size => { %><option value="<%= size %>" <%= pageSize === size ? 'selected' : '' %>><%= size %></option><% }) %></select></form></div><div class="table-scroll"><table><thead><tr><th>Mã</th><th>Giảm giá</th><th>Bắt đầu</th><th>Kết thúc</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><% if (!coupons.length) { %><tr><td colspan="6" class="empty-row">Chưa có mã khuyến mãi</td></tr><% } %><% coupons.forEach(c => { %><tr><td><strong><%= c.code %></strong><small>#<%= c.id %></small></td><td><strong><%= c.discount %>%</strong></td><td><%= c.start_date ? new Date(c.start_date).toLocaleDateString('vi-VN') : '-' %></td><td><%= c.end_date ? new Date(c.end_date).toLocaleDateString('vi-VN') : '-' %></td><td><span class="status <%= new Date(c.end_date) < new Date() ? 'bad' : new Date(c.start_date) > new Date() ? 'pending' : 'good' %>"><%= new Date(c.end_date) < new Date() ? 'Hết hạn' : new Date(c.start_date) > new Date() ? 'Sắp diễn ra' : 'Đang áp dụng' %></span></td><td><button class="button danger" type="button" data-delete-coupon="<%= c.id %>">Xóa</button></td></tr><% }) %></tbody></table></div><%- include('../layouts/admin_pagination') %></main><dialog class="dialog" id="couponDialog"><div class="dialog-header"><h2>Thêm mã khuyến mãi</h2><button class="icon-button" type="button" data-close-dialog aria-label="Đóng">×</button></div><form id="couponForm"><div class="form-grid"><label class="form-field wide">Mã giảm giá<input name="code" required></label><label class="form-field wide">Mức giảm (%)<input name="discount" type="number" min="1" max="100" required></label><label class="form-field">Bắt đầu<input name="start_date" type="datetime-local" required></label><label class="form-field">Kết thúc<input name="end_date" type="datetime-local" required></label></div><div class="dialog-actions"><button class="button secondary" type="button" data-close-dialog>Hủy</button><button class="button" type="submit">Tạo mã</button></div></form></dialog><script src="/js/admin/pages.js" defer></script></body></html>

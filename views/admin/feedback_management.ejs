<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đánh giá - Dọn Nhà Vui</title><link rel="stylesheet" href="/css/admin/app.css"></head><body><%- include('../layouts/admin_sidebar') %><main class="admin-main" data-page="feedback"><div class="page-head"><div><span class="eyebrow">CHẤT LƯỢNG / ĐÁNH GIÁ</span><h1>Đánh giá khách hàng</h1><p>Đọc phản hồi và trả lời những vấn đề cần theo dõi.</p></div></div><div id="pageNotice" hidden></div><div class="feedback-list"><% if (!feedback.length) { %><div class="empty-row">Chưa có đánh giá</div><% } %><% feedback.forEach(f => { %><article class="feedback-item"><div class="feedback-head"><div><h2><%= f.user_name || 'Khách hàng' %></h2><small>Đơn #<%= f.Orderid || '-' %> · <%= f.created_at ? new Date(f.created_at).toLocaleString('vi-VN') : '' %></small></div><span class="stars" aria-label="<%= f.rating %> trên 5 sao"><%= '★'.repeat(Math.max(0, Math.min(5, Number(f.rating) || 0))) %><%= '☆'.repeat(5 - Math.max(0, Math.min(5, Number(f.rating) || 0))) %></span></div><p><%= f.comment || '-' %></p><% if (f.admin_reply) { %><div class="notice success">Phản hồi: <%= f.admin_reply %></div><% } else { %><form data-reply-id="<%= f.id %>"><label class="form-field">Phản hồi của admin<textarea name="admin_reply" required placeholder="Nhập phản hồi..."></textarea></label><button class="button" type="submit">Gửi phản hồi</button></form><% } %></article><% }) %></div><%- include('../layouts/admin_pagination') %></main><script src="/js/admin/pages.js" defer></script></body></html>

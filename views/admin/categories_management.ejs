<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Danh mục - Dọn Nhà Vui</title><link rel="stylesheet" href="/css/admin/app.css"></head><body><%- include('../layouts/admin_sidebar') %><main class="admin-main" data-page="categories"><div class="page-head"><div><span class="eyebrow">NỘI DUNG / DANH MỤC</span><h1>Danh mục</h1><p>Nhóm các dịch vụ để khách tìm nhanh hơn.</p></div><button class="button" id="newCategory" type="button" data-open-dialog="categoryDialog"><i data-lucide="plus"></i>Thêm danh mục</button></div><div id="pageNotice" hidden></div><div class="table-toolbar"><h2>Danh sách danh mục</h2><form method="get"><label for="pageSize">Số dòng</label><select id="pageSize" name="pageSize" onchange="this.form.submit()"><% [10,20,50].forEach(size => { %><option value="<%= size %>" <%= pageSize === size ? 'selected' : '' %>><%= size %></option><% }) %></select></form></div><div class="table-scroll"><table><thead><tr><th>ID</th><th>Tên danh mục</th><th>Mô tả</th><th>Thao tác</th></tr></thead><tbody><% if (!categories.length) { %><tr><td colspan="4" class="empty-row">Chưa có danh mục</td></tr><% } %><% categories.forEach(c => { %><tr><td>#<%= c.id %></td><td><strong><%= c.name %></strong></td><td><%= c.description || '-' %></td><td><div class="cell-actions"><button class="button secondary" type="button" data-edit-category data-id="<%= c.id %>" data-name="<%= c.name %>" data-description="<%= c.description || '' %>">Sửa</button><button class="button danger" type="button" data-delete-category="<%= c.id %>">Xóa</button></div></td></tr><% }) %></tbody></table></div><%- include('../layouts/admin_pagination') %></main><dialog class="dialog" id="categoryDialog"><div class="dialog-header"><h2 id="categoryDialogTitle">Thêm danh mục</h2><button class="icon-button" type="button" data-close-dialog aria-label="Đóng">×</button></div><form id="categoryForm"><input name="id" type="hidden"><div class="form-grid"><label class="form-field wide">Tên danh mục<input name="name" required></label><label class="form-field wide">Mô tả<textarea name="description"></textarea></label></div><div class="dialog-actions"><button class="button secondary" type="button" data-close-dialog>Hủy</button><button class="button" type="submit">Lưu danh mục</button></div></form></dialog><script src="/js/admin/pages.js" defer></script></body></html>

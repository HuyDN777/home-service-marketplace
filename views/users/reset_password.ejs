<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đặt lại mật khẩu - Dọn Nhà Vui</title><link rel="stylesheet" href="/css/user/customer.css"></head><body><%- include('../layouts/header') %><main class="auth-layout"><div class="auth-media" role="img" aria-label="Chăm sóc nhà cửa"></div><div class="auth-form-wrap"><div class="auth-form"><span class="eyebrow">TÀI KHOẢN</span><h1>Đặt lại mật khẩu</h1><p>Nhập OTP đã gửi tới email của bạn.</p><form id="resetForm"><label class="form-field">Email<input name="email" type="email" autocomplete="email" required></label><label class="form-field">Mã OTP<input name="otp" inputmode="numeric" required></label><label class="form-field">Mật khẩu mới<input name="newPassword" type="password" autocomplete="new-password" minlength="8" required></label><button class="button" type="submit">Đặt lại mật khẩu</button></form><div id="authNotice" role="status" aria-live="polite"></div><div class="auth-links"><a href="/login">← Về đăng nhập</a></div></div></div></main><script src="/js/user/auth.js" defer></script></body></html>

<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đặt lịch thành công - Dọn Nhà Vui</title><link rel="stylesheet" href="/css/user/customer.css"></head><body><%- include('../layouts/header') %><main class="page-main"><div class="shell" style="max-width:720px"><span class="eyebrow">ĐẶT LỊCH THÀNH CÔNG</span><h1 class="page-title">Đơn #<%= order.id %> đã được đăng</h1><p class="page-subtitle">CTV phù hợp có thể xem và nhận ca của bạn. Theo dõi đơn để biết khi có người nhận.</p><div class="order-row" style="margin:30px 0"><div class="order-row-head"><h2><%= order.service_name %></h2><span class="status-badge status-<%= order.status %>"><%= order.status === 'PENDING' ? 'Chờ CTV nhận' : order.status %></span></div><div class="order-details"><div>Thời gian<strong><%= order.start_datetime ? new Date(order.start_datetime).toLocaleString('vi-VN') : '-' %></strong></div><div>Địa chỉ<strong><%= order.address %></strong></div><div>CTV<strong><%= order.employee_name || 'Chưa có người nhận' %></strong></div><div>Thanh toán<strong><%= order.payment_status === 'PAID' ? 'Đã thanh toán' : 'Chưa thanh toán' %></strong></div><div>Tổng tiền<strong><%= order.amount ? Number(order.amount).toLocaleString('vi-VN') + 'đ' : '-' %></strong></div></div></div><a class="button" href="/order-history">Xem đơn của tôi</a></div></main><%- include('../layouts/footer') %></body></html>

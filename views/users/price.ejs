<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Bảng giá - Dọn Nhà Vui</title><link rel="stylesheet" href="/css/user/customer.css"></head><body><%- include('../layouts/header') %><main class="page-main"><div class="shell"><div class="page-header"><span class="eyebrow">BẢNG GIÁ</span><h1 class="page-title">Giá dịch vụ</h1><p class="page-subtitle">Giá hiển thị theo đơn vị của từng dịch vụ. Tổng tiền được tính khi đặt lịch.</p></div><div id="priceList" class="service-grid"><p class="empty-state">Đang tải bảng giá...</p></div></div></main><%- include('../layouts/footer') %><script src="/js/user/customer.js" defer></script><script>document.addEventListener('DOMContentLoaded',async()=>{const el=document.getElementById('priceList');try{const items=await CustomerPages.allServices();el.innerHTML=items.map(s=>`<article class="service-card"><div class="service-card-body"><span class="service-category">${CustomerPages.escape(s.category||'Dịch vụ')}</span><h3>${CustomerPages.escape(s.name)}</h3><div class="service-card-bottom"><span class="price">${CustomerPages.money(s.price)} <small>/ ${CustomerPages.escape(s.unit||'lần')}</small></span><a class="button" href="/order?service=${encodeURIComponent(s.id)}">Đặt lịch</a></div></div></article>`).join('')||'<p class="empty-state">Chưa có dịch vụ.</p>'}catch{el.innerHTML='<p class="empty-state">Không tải được bảng giá.</p>'}});</script></body></html>

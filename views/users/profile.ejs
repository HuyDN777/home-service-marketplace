<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Tài khoản - Dọn Nhà Vui</title>
  <link rel="stylesheet" href="/css/user/customer.css">
  <link rel="stylesheet" href="/css/user/profile-avatar.css">
</head>
<body>
  <%- include('../layouts/header') %>
  <main class="page-main">
    <div class="shell">
      <div class="page-header"><span class="eyebrow">TÀI KHOẢN</span><h1 class="page-title">Thông tin của tôi</h1><p class="page-subtitle">Cập nhật thông tin liên hệ cho các lần đặt lịch.</p></div>
      <div class="profile-layout">
        <nav class="profile-sidebar"><a href="/profile" aria-current="page">Hồ sơ</a><a href="/order-history">Đơn của tôi</a></nav>
        <div class="profile-form">
          <div class="avatar-editor"><img id="profileAvatar" src="/images/user/logo.png" alt="Ảnh đại diện hiện tại"><div><label class="button button-outline" for="avatarInput">Đổi ảnh đại diện</label><input id="avatarInput" type="file" accept="image/jpeg,image/png,image/webp" hidden><p class="hint">JPG, PNG hoặc WebP, tối đa 5 MB</p></div></div>
          <div id="avatarNotice" role="status" aria-live="polite" hidden></div>
          <form id="profileForm" class="form-grid">
            <label class="form-field">Họ tên<input name="name" required></label>
            <label class="form-field">Tên đăng nhập<input name="username" required></label>
            <label class="form-field">Email<input name="email" type="email"></label>
            <label class="form-field">Số điện thoại<input name="phone" type="tel"></label>
            <label class="form-field wide">Địa chỉ<input name="address" autocomplete="street-address"></label>
            <div class="wide"><button class="button" type="submit">Lưu thay đổi</button></div>
          </form>
          <div id="profileNotice" role="status" aria-live="polite"></div>
          <section class="password-section"><h2>Đổi mật khẩu</h2><form id="passwordForm" class="form-grid"><label class="form-field">Mật khẩu cũ<input name="oldPassword" type="password" required></label><label class="form-field">Mật khẩu mới<input name="newPassword" type="password" required></label><div class="wide"><button class="button button-outline" type="submit">Đổi mật khẩu</button></div></form><div id="passwordNotice" role="status" aria-live="polite"></div></section>
        </div>
      </div>
    </div>
  </main>
  <%- include('../layouts/footer') %>
  <script src="/js/user/profile.js" defer></script>
</body>
</html>
